{
  "manifestVersion": 2,
  "publisher": "hl9565",
  "name": "pelican-test",
  "displayName": "Pelican Test",
  "version": "1.0.0",
  "description": "Run manual and scheduled SVG pelican tests.",
  "license": "Apache-2.0",
  "engines": {
    "codex-proxy-rs": ">=3.44.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "resources": {
    "web/pelican.html": "text/html"
  },
  "state": [
    {
      "namespace": "pelican-history",
      "schemaVersion": 1,
      "schema": {
        "type": "array",
        "maxItems": 20,
        "items": { "type": "object" }
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144
    },
    {
      "namespace": "pelican-archive",
      "schemaVersion": 1,
      "schema": { "type": ["object", "string"] },
      "maximumRecords": 10000,
      "maximumBytes": 16777216,
      "maximumValueBytes": 49152
    },
    {
      "namespace": "pelican-archive-index",
      "schemaVersion": 1,
      "schema": { "type": ["object", "array"] },
      "maximumRecords": 128,
      "maximumBytes": 1048576,
      "maximumValueBytes": 8192
    },
    {
      "namespace": "pelican-schedule",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 1,
      "maximumBytes": 49152,
      "maximumValueBytes": 49152
    },
    {
      "namespace": "pelican-refine",
      "schemaVersion": 1,
      "schema": { "type": ["object", "string"] },
      "maximumRecords": 64,
      "maximumBytes": 3145728,
      "maximumValueBytes": 49152
    }
  ],
  "contributes": {
    "maintenance": {
      "version": 1
    },
    "management": {
      "version": 2
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  }
}
